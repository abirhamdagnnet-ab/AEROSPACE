PORT=5000
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/aerocampus
# Optional locally; required for production schema migrations and should use a separate DDL-capable role.
DATABASE_MIGRATION_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Set to 1 behind a single trusted Render proxy; keep 0 for local development.
TRUST_PROXY_HOPS=0
SESSION_SECRET=
ADMIN_COOKIE_SAME_SITE=strict
CLIENT_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=AeroCampus <no-reply@example.com>
ADMIN_NOTIFICATION_EMAIL=admin@example.com
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
IMAGE_UPLOAD_MAX_MB=5
